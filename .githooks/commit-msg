#!/bin/bash
# commit-msg hook: workspace leak scan of the commit message
#
# A message is published with the code. housebook-leak-scan checks it
# against the same real data as the staged files: the PII denylist,
# names, identifiers, amounts and trip dates/places.

exec 1>&2

if [ "$PII_ALLOW" = "true" ]; then
    echo "⚠️  Message leak scan skipped (PII_ALLOW=true)."
    exit 0
fi

SCANNER="$(git rev-parse --show-toplevel)/.venv/bin/housebook-leak-scan"
if [ ! -x "$SCANNER" ]; then
    echo "❌ $SCANNER not found. Run ./bootstrap.sh (or pip install -e .)."
    echo "Override: PII_ALLOW=true git commit ..."
    exit 1
fi
if ! "$SCANNER" --message "$1"; then
    echo ""
    echo "❌ Real workspace data in the commit message (see above)."
    echo "Override: PII_ALLOW=true git commit ..."
    exit 1
fi

exit 0
