# Copy outside the repository and workspace, then replace every blank or
# reserved example value. A blank proxy secret makes the app fail closed.
HOUSEBOOK_AUTH_MODE=proxy
HOUSEBOOK_HOST=127.0.0.1
HOUSEBOOK_ALLOW_LOCAL_BYPASS=true
HOUSEBOOK_ALLOWED_HOSTS=housebook.example.test,localhost,127.0.0.1,[::1],::1
HOUSEBOOK_ALLOWED_ORIGINS=https://housebook.example.test,http://localhost:8000,http://127.0.0.1:8000,http://[::1]:8000
HOUSEBOOK_PROXY_SECRET=

# Point this at the decrypted local mount, never the encrypted backing path.
HOUSEBOOK_WORKSPACE_DIR=
