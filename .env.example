# External Workspace Configuration (REQUIRED, no default)
# An existing directory OUTSIDE this repository that holds your
# financial data: database, statements, receipts and live config.
# Example: HOUSEBOOK_WORKSPACE_DIR=/home/user/finance-workspace
HOUSEBOOK_WORKSPACE_DIR=

# rclone remote path for workspace sync (housebook-sync)
# Example: gdrive:/FinanceWorkspace
HOUSEBOOK_RCLONE_REMOTE=
